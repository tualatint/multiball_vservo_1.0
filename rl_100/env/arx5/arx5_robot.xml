<mujoco model="ARX L5">
  <compiler angle="radian" meshdir="assets"/>

  <option integrator="implicitfast" cone="elliptic" impratio="20" tolerance="1e-8"/>

  <default>
    <default class="arx_l5">
      <joint frictionloss="0.3" armature="0.005"/>
      <position inheritrange="1" forcerange="-500 500"/>
      <default class="finger">
        <joint frictionloss="0" type="slide"/>
        <position forcerange="-80 80"/>
      </default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="capsule" contype="1" conaffinity="1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="black_mat" rgba="0.18 0.18 0.18 1"/>

    <mesh name="base_link" file="base_link.obj"/>
    <mesh name="link1" file="link1.obj"/>
    <mesh name="link2" file="link2.obj"/>
    <mesh name="link3" file="link3.obj"/>
    <mesh name="link4" file="link4.obj"/>
    <mesh name="link5" file="link5.obj"/>
    <mesh name="link6" file="link6.obj"/>
    <mesh name="link7" file="link7.obj"/>
    <mesh name="link8" file="link8.obj"/>
    <mesh name="camera" file="camera.obj"/>
  </asset>

  <worldbody>
    <light mode="targetbodycom" target="link8" pos="1 0 1"/>
    <body name="base_link" pos="0 0 0.15">
      <geom mesh="base_link" material="black_mat" class="visual"/>
      <geom mesh="base_link" class="collision"/>
      <!-- Pedestal stand: fills the gap between the floor (z=0) and the base
           bottom (z=0.15) so the shoulder sits near table height -->
      <geom name="pedestal_vis" type="cylinder" size="0.03 0.077" pos="0 0 -0.077" material="black_mat" group="2" contype="0" conaffinity="0"/>
      <geom name="pedestal_col" type="cylinder" size="0.03 0.077" pos="0 0 -0.077" material="black_mat" group="3" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
      <body name="link1" pos="0 0 0.0565">
        <inertial pos="0.0050395 -0.0077407 0.020897" quat="0.632157 0.714526 -0.263733 0.142391" mass="0.096804"
          diaginertia="0.000118945 9.40205e-05 4.70346e-05"/>
        <joint name="joint1" axis="0 0 1" range="-3.14 3.14"/>
        <geom mesh="link1" material="black_mat" class="visual"/>
        <geom mesh="link1" class="collision"/>
        <body name="link2" pos="0.02 0 0.047">
          <inertial pos="-0.12992 -0.0011822 -2.6366e-05" quat="0.501263 0.501263 0.498734 0.498734" mass="1.1988"
            diaginertia="0.0164704 0.01646 0.000649595"/>
          <joint name="joint2" axis="0 1 0" range="0 3.14"/>
          <geom mesh="link2" material="black_mat" class="visual"/>
          <geom mesh="link2" class="collision"/>
          <body name="link3" pos="-0.264 0 0" quat="-3.67321e-06 -1 0 0">
            <inertial pos="0.16181 0.0011723 -0.05455" quat="0.518857 0.484372 0.465704 0.52848" mass="0.84082"
              diaginertia="0.0084909 0.00841207 0.000747034"/>
            <joint name="joint3" axis="0 1 0" range="0 3.14"/>
            <geom mesh="link3" material="black_mat" class="visual"/>
            <geom mesh="link3" class="collision"/>
            <geom type="box" size="0.062 0.001 0.01" pos="0.112 -0.025 -0.06" rgba="1 0 0 1" class="visual"/>
            <geom type="box" size="0.062 0.001 0.01" pos="0.112 0.023 -0.06" rgba="1 0 0 1" class="visual"/>
            <body name="link4" pos="0.245 -5e-05 -0.06">
              <inertial pos="0.041751 0.0054236 -0.03337" quat="0.919386 -0.0641253 0.311071 -0.23206" mass="0.12432"
                diaginertia="0.000303193 0.000235316 0.000101491"/>
              <joint name="joint4" axis="0 1 0" range="-1.7 1.7"/>
              <geom mesh="link4" material="black_mat" class="visual"/>
              <geom mesh="link4" class="collision"/>
              <body name="link5" pos="0.073914 5e-05 -0.083391">
                <inertial pos="-8.3435e-05 -1.5428e-05 0.052216" quat="0.998247 0 -0.0591776 0" mass="0.63601"
                  diaginertia="0.000848329 0.00082 0.000251671"/>
                <joint name="joint5" axis="0 0 1" range="-1.7 1.7"/>
                <geom mesh="link5" material="black_mat" class="visual"/>
                <geom mesh="link5" class="collision"/>
                <body name="link6" pos="0.025286 0 0.083391" quat="-3.67321e-06 1 0 0">
                  <inertial pos="0.041697 2.4368e-05 0.00014464" quat="0.5 0.5 -0.5 0.5" mass="0.44089"
                    diaginertia="0.0005 0.00038 0.00028"/>
                  <joint name="joint6" axis="1 0 0" range="-3.14 3.14"/>
                  <geom mesh="link6" material="black_mat" class="visual"/>
                  <geom mesh="link6" class="collision"/>
                  <geom mesh="camera" pos="0.06 0 -0.01" quat="-1 0 0 1" material="black_mat" class="visual"/>
                  <geom mesh="camera" pos="0.06 0 -0.01" quat="-1 0 0 1" class="collision"/>
                  <camera name="wrist_cam" pos="0.0475 0 0.075" mode="fixed" euler="0 -1.1 -1.5708"
                    focal="1.93e-3 1.93e-3" resolution="1280 720" sensorsize="3896e-6 2140e-6"/>
                  <site name="ee_site" type="sphere" size="0.005" pos="0.136 0 0" group="4" rgba="0 1 0 0"/>
                  <!-- Grasp center site: midpoint between the two fingers -->
                  <site name="grasp_site" type="sphere" size="0.005" pos="0.08657 0 -0.0002436" group="4" rgba="0 0 1 0"/>
                  <site name="left_touch_site" type="box" size="0.008 0.002 0.008" pos="0.08657 0.0249 0.005" group="4" rgba="0 1 0 0.3"/>
                  <site name="right_touch_site" type="box" size="0.008 0.002 0.008" pos="0.08657 -0.0249 0.005" group="4" rgba="0 1 0 0.3"/>
                  <body name="link7" pos="0.08657 0.024896 -0.0002436" gravcomp="1">
                    <inertial pos="-0.00035522 -0.007827 -0.0029883" quat="0.5 0.5 0.5 0.5" mass="0.064798"
                      diaginertia="3e-05 3e-05 2e-05"/>
                    <joint name="joint7" axis="0 1 0" class="finger" range="0 0.044"/>
                    <geom mesh="link7" material="black_mat" class="visual"/>
                    <!-- Fingertip collision pads. Thin boxes matching the real
                         fingertip jaw shape (measured from the link7 mesh): the
                         contact face is a ~3mm-thick plate at local y = -0.023
                         spanning x[0.0, 0.071], z[-0.018, 0.005]. Two pads per
                         finger like the official ARX L5 model: a short pad at
                         the tip (x 0.03..0.07) and a taller pad further back
                         (x 0.0..0.03). No oversized phantom blocks. -->
                    <geom name="left_finger_tip" type="box" size="0.02 0.002 0.00525" pos="0.05 -0.023 0" rgba="1 0 0 1" class="collision" friction="5.0 0.01 0.001"/>
                    <geom name="left_finger_pad" type="box" size="0.015 0.002 0.018" pos="0.015 -0.023 0" rgba="0 0 1 1" class="collision" friction="5.0 0.01 0.001"/>
                  </body>
                  <body name="link8" pos="0.08657 -0.0249 -0.00024366" gravcomp="1">
                    <inertial pos="-0.000355223 0.00782769 0.00242006" quat="0.5 0.5 0.5 0.5" mass="0.0647982"
                      diaginertia="3e-05 3e-05 2e-05"/>
                    <joint name="joint8" axis="0 1 0" class="finger" range="-0.044 0"/>
                    <geom mesh="link8" material="black_mat" class="visual"/>
                    <geom name="right_finger_tip" type="box" size="0.02 0.002 0.00525" pos="0.05 0.023 0" rgba="1 0 0 1" class="collision" friction="5.0 0.01 0.001"/>
                    <geom name="right_finger_pad" type="box" size="0.015 0.002 0.018" pos="0.015 0.023 0" rgba="0 0 1 1" class="collision" friction="5.0 0.01 0.001"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="link1"/>
  </contact>

  <equality>
    <joint joint1="joint7" joint2="joint8" polycoef="0 -1 0 0 0"/>
  </equality>

  <actuator>
    <!-- High-gain PD position controllers. The original kp/kv left a large
         steady-state gravity sag on the arm joints (j3 needed ~5.8 N*m to
         hold up, sagging 0.013 rad at kp=400), which compounded into a
         growing tracking error for EE-delta eval. Gains below are sized so the
         sag is <= ~3e-3 rad on the loaded joints while the implicitfast
         integrator stays stable. forcerange raised to -500..500 for headroom. -->
    <position name="joint1" joint="joint1" class="arx_l5" kp="800" kv="40"/>
    <position name="joint2" joint="joint2" class="arx_l5" kp="1200" kv="70"/>
    <position name="joint3" joint="joint3" class="arx_l5" kp="2000" kv="90"/>
    <position name="joint4" joint="joint4" class="arx_l5" kp="1000" kv="60"/>
    <position name="joint5" joint="joint5" class="arx_l5" kp="400" kv="30"/>
    <position name="joint6" joint="joint6" class="arx_l5" kp="400" kv="30"/>
    <!-- Gripper: firm-but-safe grip. kp=1000 / ±80 N cap: a small contact
         position error (~0.03-0.04 rad of the 0.044 slide) yields ~30-40 N of
         normal force, so the object no longer slips, while the 80 N clamp
         stays well below the old 200 N that launched the 0.05-0.08 kg
         objects like a catapult.
         PHYSICS TUNED (2026-09-02): with objects now 0.15-0.2 kg, the 80 N
         clamp was still strong enough to shove a misaligned object sideways
         on premature closure; kp 1000->600 and cap -80..80 -> -40..40 keep
         ~15-20 N contact force (plenty for a 2 N object at finger friction
         2.5) while roughly halving the knock-off impulse. -->
    <position name="gripper" joint="joint7" class="finger" kp="600" kv="50" forcerange="-40 40"/>
  </actuator>
</mujoco>