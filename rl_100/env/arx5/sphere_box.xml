<mujoco model="Sphere-in-Box Scene (single sphere -> fixed target box)">
  <!-- Fresh single-object task on the validated MetaWorld robot:
       * exactly ONE movable object: a 7 cm sphere on the table;
       * a FIXED small open-top box on the table (rigid, no free joint);
       * task: pick the sphere and place it INSIDE the box.
       Uses the same robot / table / camera / lights as arx5_robot_mw.xml so
       the depth->back-projection->FPS point-cloud pipeline and the MW
       EE-space interface are unchanged. The box geoms are NOT excluded from
       the point cloud (the policy must see the target). -->
  <include file="arx5_robot_mw.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.45 0.45 0.45" specular="0 0 0"/>
    <rgba haze="0.82 0.84 0.87 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture name="gray" type="cube" builtin="flat" rgb1="0.5 0.5 0.5" rgb2="0.5 0.5 0.5" width="1" height="1"/>
    <texture name="white" type="cube" builtin="flat" rgb1="0.92 0.92 0.92" rgb2="0.92 0.92 0.92" width="1" height="1"/>

    <material name="gray" texture="gray" specular="0.2" shininess="0.3"/>
    <material name="white" texture="white" specular="0.2" shininess="0.3"/>
    <material name="green" specular="0.2" shininess="0.3" rgba="0.15 0.75 0.2 1"/>
    <material name="box_mat" specular="0.2" shininess="0.3" rgba="0.6 0.45 0.15 1"/>
    <material name="table_mat" specular="0.0" shininess="0.0" rgba="0.32 0.32 0.32 1"/>
    <material name="floor_mat" specular="0.0" shininess="0.0" rgba="0.7 0.7 0.7 1"/>
    <material name="bg_mat" specular="0.0" shininess="0.0" rgba="0.82 0.84 0.87 1"/>
  </asset>

  <worldbody>
    <light name="light0" pos="0.5 0.5 2" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <light name="light1" pos="-0.5 -0.5 2" dir="0 0 -1" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
    <light name="light2" pos="0 0 3" dir="0 0 -1" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="2 2 0.1" material="floor_mat" contype="1" conaffinity="1"/>

    <!-- Light backdrop room (visual only, no collision) -->
    <geom name="bg_ceiling" type="box" size="5 5 0.02" pos="0.5 0 6.0" material="bg_mat" contype="0" conaffinity="0"/>
    <geom name="bg_back" type="box" size="0.02 5 6.1" pos="-2.5 0 3.0" material="bg_mat" contype="0" conaffinity="0"/>
    <geom name="bg_left" type="box" size="3 0.02 6.1" pos="0.5 -2.5 3.0" material="bg_mat" contype="0" conaffinity="0"/>
    <geom name="bg_right" type="box" size="3 0.02 6.1" pos="0.5 2.5 3.0" material="bg_mat" contype="0" conaffinity="0"/>

    <!-- Table (top surface at world z = 0.19) -->
    <body name="table" pos="0.36 0 0.15" mocap="false">
      <geom name="table_top" type="box" size="0.30 0.45 0.04" material="table_mat" contype="1" conaffinity="1" friction="0.5 0.005 0.0001"/>
      <geom name="table_leg1" type="box" size="0.02 0.02 0.11" pos="-0.27 -0.42 -0.13" material="table_mat"/>
      <geom name="table_leg2" type="box" size="0.02 0.02 0.11" pos="-0.27 0.42 -0.13" material="table_mat"/>
      <geom name="table_leg3" type="box" size="0.02 0.02 0.11" pos="0.27 -0.42 -0.13" material="table_mat"/>
      <geom name="table_leg4" type="box" size="0.02 0.02 0.11" pos="0.27 0.42 -0.13" material="table_mat"/>
    </body>

    <!-- Object-facing tabletop collider: analytic plane (exact vertical
         normal), coplanar with the box top (world z=0.19), render-transparent. -->
    <body name="table_surface" pos="0.36 0 0.19">
      <geom name="table_top_objplane" type="plane" size="0.30 0.45 0.05" rgba="0 0 0 0" condim="6" friction="1.5 0.005 0.0002"/>
    </body>

    <!-- Fixed camera for the depth-based point cloud (same pose as arx5.xml) -->
    <camera name="cam_pc" pos="0.4843 -0.3604 0.8672" xyaxes="0.7727 0.6347 -0.0000  -0.4724 0.5752 0.6678" fovy="45.0"/>

    <!-- ===================== Fixed target box =====================
         Rigid open-top container on the table (no free joint -> static).
         Outer footprint 0.20 x 0.20 m, inner footprint 0.18 x 0.18 m,
         wall height 0.08 m (rim at z = 0.27). Center (0.30, 0.15),
         inside the verified reachable+liftable region of the robot.
         Four thin walls; the floor is the analytic table_surface plane. -->
    <body name="target_box" pos="0.30 0.15 0.19">
      <geom name="box_wall_back"  type="box" size="0.10 0.01 0.04" pos="0.0 -0.09 0.04" material="box_mat" contype="1" conaffinity="1" friction="0.5 0.005 0.0001"/>
      <geom name="box_wall_front" type="box" size="0.10 0.01 0.04" pos="0.0 0.09 0.04"  material="box_mat" contype="1" conaffinity="1" friction="0.5 0.005 0.0001"/>
      <geom name="box_wall_left"  type="box" size="0.01 0.10 0.04" pos="-0.09 0.0 0.04" material="box_mat" contype="1" conaffinity="1" friction="0.5 0.005 0.0001"/>
      <geom name="box_wall_right" type="box" size="0.01 0.10 0.04" pos="0.09 0.0 0.04"  material="box_mat" contype="1" conaffinity="1" friction="0.5 0.005 0.0001"/>
    </body>

    <!-- ===================== The only object: sphere =====================
         7 cm diameter sphere (radius 0.035). Light foam-ball mass (0.08 kg)
         so the fast scripted carry cannot fling it out of the pinch, and
         enough friction to sit stably on the table / box floor. -->
    <body name="sphere" pos="0.3 -0.05 0.19" mocap="false">
      <freejoint name="sphere_joint"/>
      <inertial pos="0 0 0" mass="0.08" diaginertia="0.00004 0.00004 0.00004"/>
      <geom name="sphere_visual" type="sphere" size="0.035" material="green" contype="1" conaffinity="1" condim="6" friction="1.5 0.005 0.0002" solref="0.004 1"/>
    </body>
  </worldbody>

  <!-- Sensors -->
  <sensor>
    <touch name="left_touch" site="left_touch_site"/>
    <touch name="right_touch" site="right_touch_site"/>
  </sensor>

  <!-- The sphere rests on the analytic table_surface plane (not the hull-box
       table body), same exclude pattern as the reference scenes. -->
  <contact>
    <exclude body1="sphere" body2="table"/>
  </contact>
</mujoco>
